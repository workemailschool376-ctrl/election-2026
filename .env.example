# ─── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Used when running: npm run dev
# Keep this as-is for local development (points to your local SQLite file)
DATABASE_URL="file:../dev.db"

# ─── PRODUCTION (Vercel + Turso) ──────────────────────────────────────────────
# Get these from: https://app.turso.tech → your database → Connect
# Set these in Vercel Dashboard → Project Settings → Environment Variables
TURSO_DATABASE_URL="libsql://your-db-name-your-username.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# ─── ADMIN ────────────────────────────────────────────────────────────────────
# Set this in Vercel too — the password to access the admin panel
ADMIN_PASSWORD="your-admin-password"
